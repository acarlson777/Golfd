        type: 3}
      propertyPath: dialogueEntries.Array.data[0].lines.Array.data[0]
      value: "Hello there! Welcome to the wonderful world of Golf\u2019d and I. Ron! "
      objectReference: {fileID: 0}
    - target: {fileID: 7023487528945028877, guid: 2663f3877fa2140f8999f259cb63856a,
        type: 3}
      propertyPath: dialogueEntries.Array.data[0].lines.Array.data[1]
      value: "Sorry, I\u2019m I. Ron, your whimsical Iron companion. Not to be confused
        with Wood. NEVER confuse me with a Wood, those guys are the WORST!"
      objectReference: {fileID: 0}
    - target: {fileID: 7023487528945028877, guid: 2663f3877fa2140f8999f259cb63856a,
        type: 3}
      propertyPath: dialogueEntries.Array.data[0].lines.Array.data[2]
      value: "Anyways, as your caddy, I\u2019ll be guiding you through your Golf\u2019d
        adventure, let\u2019s begin!"
      objectReference: {fileID: 0}
