      propertyPath: dialogueEntries.Array.data[2].images.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6960761786838772680, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[0]
      value: Rats! They found a way around our death pits! And the gate!
      objectReference: {fileID: 0}
    - target: {fileID: 6960761786838772680, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[1]
      value: "This wouldn\u2019t\u2019ve happened if YOU remembered to buy a gate
        that wasn\u2019t electric!"
      objectReference: {fileID: 0}
    - target: {fileID: 6960761786838772680, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[2]
      value: "You were there when we bought it, why didn\u2019t you say anything?! "
      objectReference: {fileID: 0}
    - target: {fileID: 6960761786838772680, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[3]
      value: "Guys, stop fighting! Let\u2019s report back."
      objectReference: {fileID: 0}
    - target: {fileID: 6960761786838772680, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[4]
      value: 'Putts is going to be so mad at us. '
      objectReference: {fileID: 0}
    - target: {fileID: 6960761786838772680, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].names.Array.data[0]
