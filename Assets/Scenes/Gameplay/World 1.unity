      propertyPath: dialogueEntries.Array.data[15].images.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[0].lines.Array.data[0]
      value: "From all of us here at Golf\u2019d Inc., we wish you good luck and
        happy putting!"
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[1].lines.Array.data[0]
      value: "Welcome to THE TRIANGLE\u2122. With its distinct lack of twists or
        turns, it\u2019s known for being straight and to the point, three actually."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[1].lines.Array.data[1]
      value: Good luck and happy putting!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[0]
      value: "Welcome to THE WINDMILLS\u2122."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[1]
      value: Known for its smooth greens and nicely cut rough, this hole should just
        be a matter of hitting the ball into the ho--
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[2]
      value: "--ld on\u2026I don\u2019t remember these pits being here last time."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[3]
      value: "Shouldn\u2019t be too big of a deal\u2026as long as your ball never
        goes there\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[4]
      value: "...I\u2019ll call CORPORATE to see what\u2019s up with this slightly
        frightening change."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[5]
      value: My best guess is that the greenskeeper must have been having a very
        bad day.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].lines.Array.data[6]
      value: Anyways, good luck and happy putting!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].names.Array.data[2]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].names.Array.data[3]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].names.Array.data[4]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].names.Array.data[5]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].names.Array.data[6]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[3].lines.Array.data[0]
      value: "Welcome to THE SINGULAR WINDMILL\u2122. *sigh* I\u2019ve been telling
        CORPORATE we need to change the name of this hole. "
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[4].lines.Array.data[0]
      value: "Oh no! It\u2019s the dastardly Woods!"
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[4].lines.Array.data[1]
      value: "These guys are known to mess with Golf\u2019d Inc. courses, and this
        time it looks like they are literally gatekeeping this level."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[4].lines.Array.data[2]
      value: "As your caddy however, I know that there\u2019s a safety precaution
        which means that the gate will open in the case it is disconnected from electricity. "
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[4].lines.Array.data[3]
      value: Also as your caddy, I know that there just so happens to be a button
        which does exactly that somewhere on this hole.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[4].lines.Array.data[4]
      value: Find that button and open the gate!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[4].names.Array.data[2]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[4].names.Array.data[3]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[4].names.Array.data[4]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[5].lines.Array.data[0]
      value: I just got word from CORPORATE that our in-house ball retrieval services
        are down, along with the power.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[5].lines.Array.data[1]
      value: "Now that I think about it, that might\u2019ve been our fault\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[5].lines.Array.data[2]
      value: Anyways, be careful not to trip into any sand traps, ok? The nearest
        hospital is almost 30 strokes away!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[5].lines.Array.data[3]
      value: Good luck and happy putting!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[6].lines.Array.data[0]
      value: "Welcome to the SINGULAR WINDMILL PART 2\u2122. Wow, CORPORATE really
        needs to look into changing the names of these holes."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[6].lines.Array.data[1]
      value: "Speaking of CORPORATE, I\u2019m now remembering they recently installed
        a power switch inside the hole just past the windmill."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[6].lines.Array.data[2]
      value: "I thought it was a weird decision at the time but I guess it wasn\u2019t
        after all."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[6].lines.Array.data[3]
      value: Try to bring the power back!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[7].lines.Array.data[0]
      value: CORPORATE recently issued a mandate for a golf pun to be given to players
        after every hole to improve player retention.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[7].lines.Array.data[1]
      value: "Let\u2019s see what we got here\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[7].lines.Array.data[2]
      value: "\u2026okay this one is alright."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[7].lines.Array.data[3]
      value: "\u201CThat might\u2019ve been a little rough, but I\u2019m sure you\u2019ll
        be on the green in no time!\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[7].lines.Array.data[4]
      value: Do you feel any more retained than you were previously?
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[7].names.Array.data[1]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[7].names.Array.data[2]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[7].names.Array.data[3]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[7].names.Array.data[4]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[8].lines.Array.data[0]
      value: "CORPORATE also wants me to mention that this particular course is sponsored
        by \u201CJust So Many Investments Inc.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[8].lines.Array.data[1]
      value: Apparently, their parent company also owns minigolf courses so why they
        wanted an ad here, I have no idea.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[8].lines.Array.data[2]
      value: "Speaking of CORPORATE, here\u2019s one from them: Why are badly hit
        golf balls on the first hole the tastiest?"
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[8].lines.Array.data[3]
      value: "Because they\u2019re breakfast balls!"
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[8].names.Array.data[2]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[8].names.Array.data[3]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[9].lines.Array.data[0]
      value: Great work in getting through that holey challenge!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[9].lines.Array.data[1]
      value: "I\u2019ve seen holes in one, but I\u2019ve never heard of two gaping
        holes in one hole."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[9].lines.Array.data[2]
      value: "CORPORATE didn\u2019t seem to know about these extra holes--something\u2019s
        off here."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[9].names.Array.data[2]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[10].lines.Array.data[0]
      value: It seems those evil Woods have gotten away for now but I have no doubts
        that they will return.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[10].lines.Array.data[1]
      value: Keep your club face open--I mean your eyes peeled.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[11].lines.Array.data[0]
      value: You navigated that with the confidence of a Driver!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[11].lines.Array.data[1]
      value: "Keep it up and you\u2019ll be acing levels in no time! "
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[12].lines.Array.data[0]
      value: 'We had originally built that windmill to get out of a power contract
        with Puttz and Co. '
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[12].lines.Array.data[1]
      value: They used to charge us $20 for each swing above par!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[12].lines.Array.data[2]
      value: "Also this is slightly awkward but due to wear and tear over the years,
        we\u2019ve exhausted this courses\u2019 Neon Nightscape holes."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[12].lines.Array.data[3]
      value: "I\u2019ll meet you on our next course, Moana Water, for the remaining
        holes."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[12].lines.Array.data[4]
      value: I hope you're ready for a vacation!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[12].names.Array.data[4]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[13].lines.Array.data[0]
      value: "CORPORATE would like me to extend you an official congratulations from
        all of us here at Golf\u2019d Inc. for making it to your first hole of the
        day!"
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[13].lines.Array.data[1]
      value: Wait a minute the hole is not here, is it?
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[13].lines.Array.data[2]
      value: "Try moving your phone--sorry--DIGITAL PUTTER\u2122 around to get a
        good look at the ground."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[13].lines.Array.data[3]
      value: ' If done properly, CORPORATE tells me you should see a grid of dots
        appear.'
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[13].lines.Array.data[4]
      value: After seeing the grid of dots, you will need to tap anywhere on that
        grid to place your level.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[13].lines.Array.data[5]
      value: "Once your level is placed, pressing and holding the screen of your
        DIGITAL PUTTER\u2122 will make your club appear."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].lines.Array.data[0]
      value: 'Uh oh, it looks like that disconnected the electricity for more than
        just the gate. '
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].lines.Array.data[1]
      value: Luckily, we just updated our golf balls to generate energy when hit
        which should keep the lights at low power for a short time.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].lines.Array.data[2]
      value: "Still, we should definitely find a way to get the power fully back
        on before CORPORATE realizes it\u2019s gone out."
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].lines.Array.data[3]
      value: One of these was the explode on-cut wire, and one of them was extra
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].lines.Array.data[4]
      value: '*snip*'
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].lines.Array.data[5]
      value: Oh hey it worked, alright, happy putting!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].names.Array.data[0]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].names.Array.data[1]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].names.Array.data[2]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].names.Array.data[3]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].names.Array.data[4]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[14].names.Array.data[5]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].lines.Array.data[0]
      value: Oh, I forgot to mention, the button that opened the gate also powered
        down the generator which runs the lights.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].lines.Array.data[1]
      value: Luckily, your ball comes with a light pre-installed! Free of charge.
        Give me a second to activate it.
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].lines.Array.data[2]
      value: Which wire did I need to cut again?
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].lines.Array.data[3]
      value: One of these was the explode on-cut wire, and one of them was extra
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].lines.Array.data[4]
      value: '*snip*'
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].lines.Array.data[5]
      value: Oh hey it worked, alright, happy putting!
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].names.Array.data[0]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].names.Array.data[1]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].names.Array.data[2]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].names.Array.data[3]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].names.Array.data[4]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[15].names.Array.data[5]
      value: I. Ron
      objectReference: {fileID: 0}
    - target: {fileID: 1564932514128694432, guid: b7e550269444e4d25a5d2a3cd7ab2ec2,
        type: 3}
      propertyPath: dialogueEntries.Array.data[2].images.Array.data[2]
      value: 
      objectReference: {fileID: 21300000, guid: cc5df9a9b52d18d4dbcb7d8bc3e5549c,
        type: 3}
